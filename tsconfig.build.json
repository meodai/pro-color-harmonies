  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "allowImportingTsExtensions": false,
    "moduleResolution": "node"
  },
  "include": ["src"],
  "exclude": ["src/vite-env.d.ts", "src/**/*.test.ts", "tests", "src/main.ts"]
}
